{
  "name": "@chess-assistant/desktop",
  "version": "0.1.0",
  "description": "Local desktop chess analysis assistant powered by Stockfish",
  "author": "André NV",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"vite --configLoader runner --host 127.0.0.1\" \"wait-on dist-electron/main.js http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist-electron/main.js\"",
    "build": "tsc -p tsconfig.electron.json && vite build --configLoader runner",
    "package:win": "node ../../node_modules/electron/install.js && npm run build && electron-builder --win nsis --x64",
    "package:dir": "node ../../node_modules/electron/install.js && npm run build && electron-builder --dir --win --x64",
    "smoke:backend": "npm run build && node scripts/smoke-backend.mjs",
    "test": "vitest run --configLoader runner",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json"
  },
  "dependencies": {
    "chess.js": "^1.4.0"
  },
  "devDependencies": {
    "@chess-assistant/contracts": "*",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "44.4.5",
    "electron-builder": "^26.0.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^5.0.1",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "dev.andrenv14.chessassistant",
    "productName": "Chess Assistant",
    "asar": true,
    "electronDist": "../../node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**",
      "dist-renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../backend/dist/chess-assistant-backend",
        "to": "backend"
      }
    ],
    "win": {
      "icon": "build/icon.svg",
      "target": [
        "nsis"
      ],
      "artifactName": "Chess-Assistant-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
