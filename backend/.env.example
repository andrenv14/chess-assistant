STOCKFISH_PATH=C:\\tools\\stockfish\\stockfish-windows-x86-64-avx2.exe
# Opcional: entry point instalado pelo repositório oficial CSSLab/maia3.
MAIA3_PATH=C:\\tools\\maia3\\Scripts\\maia3-5m.exe
CHESS_ASSISTANT_HOST=127.0.0.1
CHESS_ASSISTANT_PORT=8765
# Opcional: diretório do SQLite local. O padrão usa a pasta de dados do sistema.
# CHESS_ASSISTANT_DATA_DIR=C:\Users\you\AppData\Local\ChessAssistant
HISTORY_LIMIT=200

# Explicações opcionais via OpenRouter/OpenResponses. Nenhum modelo local é necessário.
# Nunca versionar uma chave real; backend/.env é ignorado pelo Git.
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemini-3.8-flash
LLM_MAX_OUTPUT_TOKENS=3200
