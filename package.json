{
  "name": "chess-assistant",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "apps/extension",
    "packages/contracts"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:desktop": "npm run dev --workspace @chess-assistant/desktop",
    "smoke:desktop-backend": "npm run smoke:backend --workspace @chess-assistant/desktop",
    "smoke:packaged-backend": "node scripts/smoke-packaged-backend.mjs",
    "build:extension": "npm run build --workspace @chess-assistant/extension",
    "package:backend": "pwsh -NoProfile -File ./scripts/build-backend.ps1",
    "package:win": "npm run package:backend && npm run package:win --workspace @chess-assistant/desktop",
    "package:dir": "npm run package:backend && npm run package:dir --workspace @chess-assistant/desktop",
    "qa:portfolio": "electron scripts/capture-portfolio.mjs",
    "qa:live-extension": "electron scripts/smoke-live-extension.mjs",
    "qa:installer": "pwsh -NoProfile -File ./scripts/smoke-installer.ps1",
    "verify:signature": "pwsh -NoProfile -File ./scripts/verify-signature.ps1"
  },
  "engines": {
    "node": ">=22"
  }
}
